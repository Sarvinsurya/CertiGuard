# CertiGuard backend configuration (placeholders only — never commit real secrets)

# Runtime
NODE_ENV=development
PORT=4000

# CORS: the browser origin allowed to call the API (use HTTPS in production)
FRONTEND_ORIGIN=http://localhost:5173

# Sessions / cookies
# In production set COOKIE_SECURE=true (requires HTTPS) and consider SameSite=strict.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800      # absolute session lifetime (8h)
SESSION_IDLE_SECONDS=1800      # idle timeout (30m)

# Authentication policy
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_RESET_TTL_SECONDS=3600
AUTH_MFA_MAX_ATTEMPTS=5
AUTH_MFA_WINDOW=1

# Initial administrator bootstrap (used once, only if no admin exists).
# Choose a strong password; the account must change it on first login.
CERTIGUARD_ADMIN_EMAIL=
CERTIGUARD_ADMIN_PASSWORD=
CERTIGUARD_ADMIN_NAME=Security Administrator

# Demo seed password (local demonstration ONLY; do not use in production)
CERTIGUARD_DEMO_PASSWORD=

# Optional: relocate data/keys/db/storage (defaults to the backend directory)
# CERTIGUARD_DATA_DIR=/var/lib/certiguard

# NOTE: Cryptographic keys (Ed25519 signing, AES data, HMAC pseudonymization,
# MFA secret-encryption) are generated locally under backend/keys/ by
# `npm run init:keys`. They are NOT environment variables. For production, back
# them up securely and plan rotation — see DEPLOYMENT.md and SECURITY.md.
