# CertiGuard frontend configuration (placeholders only)
#
# The frontend talks to the backend via the dev proxy (/api -> http://localhost:4000),
# configured in vite.config.ts. No secrets belong in the frontend.
#
# For production, serve the built frontend behind the same origin as the API (or
# configure the reverse proxy to forward /api to the backend) so that the
# HttpOnly session cookie is sent with requests.
#
# VITE_API_BASE_URL=/api
